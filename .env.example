# Copy to .env.local for local development, and set the same values in your
# Vercel project settings for production.

# Required: one model key. Read only by the serverless functions in /api —
# never sent to the browser.
#
# Perplexity is the default. Its Sonar models answer from a live web search and
# cite what they used. Get a key at https://console.perplexity.ai
PERPLEXITY_API_KEY=pplx-...

# Or Claude instead — dearer and doesn't search by default, but it's the one
# that supports MCP connectors and writes replies long enough for the Code
# workspace to build a real page. https://console.anthropic.com → API Keys.
# Set both and Perplexity wins, so the cheaper one is never a surprise.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: accounts, saved chats, and server-side connector tokens.
# Leave these unset and Polstar runs signed-out, storing everything in the
# browser. See supabase/README.md for the ten-minute setup.
#
# The VITE_ prefix is load-bearing: Vite compiles those two into the JavaScript
# it ships to browsers, and refuses to ship anything else. That is what keeps
# the service-role key on the server.

# Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Project Settings → API → anon public key. Safe in a browser: every table it
# can reach is guarded by row-level security keyed to the signed-in user.
VITE_SUPABASE_ANON_KEY=
# Project Settings → API → service_role secret key. Bypasses all row-level
# security. Server only — never add a VITE_ prefix to this one.
SUPABASE_SERVICE_ROLE_KEY=

# Per user, per calendar month, input and output tokens together. 0 removes it.
#
# 2,000,000 is roughly 430 messages — about 14 a day, which a tester will not
# reach by using the product normally. It's a circuit breaker for a runaway
# script or a shared login, not a budget: the budget is how many people you
# invite. A user who somehow spent all of it costs about $11 on sonar-pro.
# The arithmetic, and how to watch what's actually being spent, is in
# supabase/README.md → Spending.
SELFLIGHT_MONTHLY_TOKEN_CAP=2000000

# Optional: dictation for browsers that can't do speech recognition themselves.
#
# Chrome, Edge and Safari transcribe on-device for free and never touch this.
# Firefox has none, so it records audio and posts it to /api/transcribe — which
# needs somewhere to send it. Any OpenAI-compatible endpoint works.
#
# Whisper on OpenAI is about $0.006 a minute. Groq's whisper-large-v3-turbo is a
# fraction of that: set TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1 and
# TRANSCRIBE_MODEL=whisper-large-v3-turbo.
#
# Leave unset and the microphone simply doesn't appear in Firefox.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1

# Optional: connecting an account by signing in.
#
# Each service needs an OAuth app registered with it — a five-minute job, done
# once, after which everyone who uses your deployment just presses Connect. The
# callback URL to register is https://your-app.vercel.app/api/oauth?action=callback
#
# A service with nothing set here doesn't appear as a button that fails after
# the redirect; the Connectors panel shows which variables it's waiting for.
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# VERCEL_CLIENT_ID=
# VERCEL_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Optional: the failure log, and whatever acts on it.
#
# Every failure is recorded either way — these two decide who finds out. With a
# webhook set, each new failure is POSTed the moment it's filed. The secret
# guards /api/failures, which is how a workflow reads the backlog and marks one
# resolved. Without the secret that route is off rather than open: an unguarded
# list of every way a deployment breaks is a gift to somebody looking for one.
#
# README.md → "When it breaks, and when it doesn't know" has the shape of the
# n8n workflow and the exact curl calls.
# N8N_FAILURE_WEBHOOK_URL=
# FAILURE_FEED_SECRET=

# Optional: routines (scheduled prompts). The scheduler is /api/cron, wired to a
# 15-minute cron in vercel.json. Set this and Vercel signs its own calls with
# it; without it the endpoint accepts only Vercel's own cron header, and nothing
# else — an open one is a way for a stranger to spend your model budget.
#
# Note that Vercel's Hobby plan only runs cron once a day. Anything more
# frequent needs Pro.
# CRON_SECRET=any-long-random-string

# Where a routine's email delivery goes, and where the failure log posts. Point
# it at an n8n webhook (or anything that accepts JSON). Unset, routines that ask
# for email say so instead of reporting a delivery that never happened.
# N8N_WEBHOOK_URL=https://your-n8n/webhook/selflight
